      "name": "Prepare Regen Submit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        64
      ],
      "parameters": {
        "jsCode": "const row = $input.first().json;          // matched sheet row\nconst decision = $('Switch on action').item.json;\nconst source_url = row.youtube_url || '';\nif (!source_url) {\n  throw new Error('Could not resolve youtube_url for folder ' + (decision.folder_id || '?') + ' from the sheet.');\n}\nreturn [{ json: {\n  source_video_url: source_url,\n  max_clip_count: 7,\n  language: 'en',\n  max_clip_duration: 60,\n  regenerate_focus: decision.regenerate_focus || '',\n  regenerated_from_folder: decision.folder_id,\n  decision_source: decision.decision_source,\n}}];\n"
      }
    },
