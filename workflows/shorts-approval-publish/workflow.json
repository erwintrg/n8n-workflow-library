    {
      "name": "Parse Agent Decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        112
      ],
      "parameters": {
        "jsCode": "let output = $input.first().json.output;\nif (typeof output === 'string') {\n  const m = output.match(/\\{[\\s\\S]*\\}/);\n  output = m ? JSON.parse(m[0]) : { decisions: [] };\n}\nreturn output.decisions.map(d => ({ json: { ...d, decision_source: 'email_reply' } }));\n"
      }
