    {
      "name": "Gemini: Generate Title + Desc + 3 Hashtags",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        -240
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"Generate YouTube Shorts metadata for this clip.\\n\\nRules:\\n- title: <= 70 chars TOTAL including 3 hashtags. Compelling, hook-style.\\n- 3 hashtags: short, relevant, no spaces (e.g. #leadership). Embed AT END of title.\\n- description: 2-4 sentences on what the clip is about, end with a CTA to watch the full video.\\n\\nClip name: \" + ($('Klap: Export Status').item.json.name || 'short clip')\n    }]\n  }],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"responseJsonSchema\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"title\": {\"type\": \"string\"},\n        \"description\": {\"type\": \"string\"},\n        \"hashtags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}\n      },\n      \"required\": [\"title\", \"description\", \"hashtags\"]\n    },\n    \"temperature\": 0.4\n  }\n}",
        "options": {}
      }
    },
    {
      "name": "Prepare YouTube Upload Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1584,
        -240
      ],
      "parameters": {
        "jsCode": "const meta = JSON.parse($input.first().json.candidates[0].content.parts[0].text);\nconst exportData = $('Klap: Export Status').item.json;\nconst decision = $('Switch on action').item.json;\nconst hashtags = (meta.hashtags || []).slice(0, 3).map(h => h.startsWith('#') ? h : '#' + h).join(' ');\nconst titleRaw = (meta.title.includes('#') ? meta.title : (meta.title + ' ' + hashtags));\nconst title = titleRaw.slice(0, 100);\nreturn [{ json: {\n  src_url: exportData.src_url,\n  title,\n  description: meta.description,\n  publish_when: decision.publish_when || 'immediate',\n  privacy: 'private', // forced for client-slug self-test; switch to dynamic for production\n  clip_id: decision.clip_id,\n  folder_id: decision.folder_id,\n  decision_source: decision.decision_source,\n}}];\n"
      }
    },
