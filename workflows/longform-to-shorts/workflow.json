    {
      "name": "Gemini Parse Intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        -48
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"You are a parser. Extract the structured short-clip request from this client email body.\\n\\nRules:\\n- youtube_url: full URL (always required).\\n- max_clip_count: integer count of shorts requested. Omit if not stated.\\n- max_clip_duration: integer seconds. Parse \\\"under 45 seconds\\\", \\\"45s\\\", \\\"a minute\\\" (60), \\\"30 secs\\\" -> integer seconds. Omit if not stated.\\n- language: ISO 639-1 (en/es/fr/de). Omit if not stated.\\n- emojis: boolean. true if they want emojis in the captions, false if they say no emojis. Omit if not mentioned.\\n- intro_title: boolean. true if they want an intro title card on the clip. Omit if not mentioned.\\n- reframe: boolean. true to auto-reframe to vertical, false to keep original framing. Omit if not mentioned.\\n- remove_silences: boolean. true to cut silences/dead air. Omit if not mentioned.\\n- focus_intent: short phrase describing topics to favor. Omit if not stated.\\n- exclude_intent: short phrase describing topics to skip. Omit if not stated.\\n- notes: any other instructions. Omit if none.\\n\\nOMIT fields not explicitly stated. Do not invent values. (Caption styling is handled downstream by VEED, not here.)\\n\\n=== EMAIL FROM ===\\n\" + $json.from_address + \"\\n=== BODY ===\\n\" + $json.raw_email + \"\\n=== END ===\"\n    }]\n  }],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"responseJsonSchema\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"youtube_url\":       {\"type\": \"string\"},\n        \"language\":          {\"type\": \"string\"},\n        \"max_clip_count\":    {\"type\": \"integer\"},\n        \"max_clip_duration\": {\"type\": \"integer\"},\n        \"emojis\":            {\"type\": \"boolean\"},\n        \"intro_title\":       {\"type\": \"boolean\"},\n        \"reframe\":           {\"type\": \"boolean\"},\n        \"remove_silences\":   {\"type\": \"boolean\"},\n        \"focus_intent\":      {\"type\": \"string\"},\n        \"exclude_intent\":    {\"type\": \"string\"},\n        \"notes\":             {\"type\": \"string\"}\n      },\n      \"required\": [\"youtube_url\"]\n    },\n    \"temperature\": 0.0\n  }\n}",
        "options": {}
      }
    },
    {
      "name": "Parse Gemini JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        -48
      ],
      "parameters": {
        "jsCode": "const text = $input.first().json.candidates[0].content.parts[0].text;\nconst intent = JSON.parse(text);\nconst incoming = $('Extract from Email').first().json;\nreturn [{ json: {\n  ...incoming,\n  ...intent,\n  max_clip_count: intent.max_clip_count ?? 5,\n  max_clip_duration: intent.max_clip_duration ?? 60,\n  language: intent.language ?? 'en',\n  emojis: intent.emojis ?? false,\n  intro_title: intent.intro_title ?? false,\n  reframe: intent.reframe ?? true,\n  remove_silences: intent.remove_silences ?? true,\n}}];\n"
      }
    },
