            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Did GoHighLevel accept it?": {
      "main": [
        [
          {
            "node": "Attach the details as a note",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Flag it and keep the payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Attach the details as a note": {
      "main": [
        [
          {
            "node": "Open an opportunity in the right pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Open an opportunity in the right pipeline": {
      "main": [
        [
          {
            "node": "Log the payload and the answer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every hour, look at what failed": {
      "main": [
        [
          {
            "node": "Read the failed rows from the log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read the failed rows from the log": {
      "main": [
        [
          {
            "node": "Only the ones tried less than three times",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only the ones tried less than three times": {
      "main": [
        [
          {
