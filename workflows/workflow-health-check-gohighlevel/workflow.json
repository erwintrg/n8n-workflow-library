{
  "name": "Workflow health check for GoHighLevel",
  "nodes": [
    {
      "name": "Note: the problem",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -20,
        -316
      ],
      "parameters": {
        "content": "## What you asked for, in plain English\n\n1. You have workflows running in GoHighLevel, n8n or Make\n2. One of them is not firing the way it should\n3. Someone has to open it and check every trigger and action\n4. Then test whether the data really reached the connected tools\n5. Goal: find the step that breaks, fix it or tell you what to change\n",
        "height": 206,
        "width": 543,
        "color": 1
      }
    },
    {
      "name": "Note: my take",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -20,
        380
      ],
      "parameters": {
        "content": "## To go live, we wire\n\n- Most of these turn out to be a filter on the trigger, so that is the first thing I open.\n- A credential re-created and never re-selected fails quietly. Green run, nothing happens.\n- Send the workflow and what you expected, and you get the broken step plus the fix back.\n",
        "height": 230,
        "width": 640,
        "color": 5
      }
    },
    {
      "name": "Point it at a workflow",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "formTitle": "Workflow health check",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Workflow name or ID",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Platform",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "GoHighLevel"
                  },
                  {
                    "option": "n8n"
                  },
                  {
                    "option": "Make.com"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "What should happen",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Test email",
              "fieldType": "email",
              "requiredField": true
            }
          ]
        },
        "options": {},
        "formDescription": "Tell it which workflow to check and what should happen."
      },
      "notes": "name it and what should happen",
      "notesInFlow": true
    },
    {
      "name": "Pull the workflow out of GoHighLevel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "url": "https://services.leadconnectorhq.com/workflows/",
        "options": {},
        "method": "GET",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "locationId",
              "value": "[YOUR LOCATION ID]"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "notes": "triggers, actions and filters",
      "notesInFlow": true
    },
    {
      "name": "Send one test contact through it",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "url": "https://services.leadconnectorhq.com/contacts/upsert",
        "options": {},
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ locationId: '[YOUR LOCATION ID]', email: $json['Test email'], firstName: 'Workflow', lastName: 'Healthcheck', source: 'n8n health check', tags: ['healthcheck'] }) }}"
      },
      "notes": "one dummy contact, tagged test",
      "notesInFlow": true
    },
    {
      "name": "Wait for the actions to run",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        720,
        0
      ],
      "parameters": {
        "amount": 2,
        "unit": "minutes",
        "resume": "timeInterval"
      },
      "notes": "two minutes, then look again",
      "notesInFlow": true
    },
    {
      "name": "Read the contact back out",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "url": "=https://services.leadconnectorhq.com/contacts/{{ $('Send one test contact through it').item.json.contact.id }}",
        "options": {},
        "method": "GET",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "notes": "tags, custom fields, pipeline stage",
      "notesInFlow": true
    },
    {
      "name": "Compare it with what should happen",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1-mini",
          "cachedResultName": "gpt-4.1-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You review CRM automations in GoHighLevel, n8n and Make. You get a workflow definition, what the client expected to happen, and the state of the test contact after the run. Work out whether the expected result actually happened. Check in this order: did the trigger match (filters, tag conditions, pipeline stage), did every action run, did the data land in the right field. Custom fields and tags are compared by value, not by label. Answer with JSON only: {\"passed\": boolean, \"broken_step\": string, \"likely_cause\": string, \"fix\": string, \"confidence\": \"high\" | \"medium\" | \"low\"}. When you are not sure, say so in confidence and put what you would check next in fix. Never invent a field that is not in the data."
            },
            {
              "role": "user",
              "content": "=Workflow under test: {{ $('Point it at a workflow').item.json['Workflow name or ID'] }} on {{ $('Point it at a workflow').item.json['Platform'] }}.\n\nWhat should have happened:\n{{ $('Point it at a workflow').item.json['What should happen'] }}\n\nThe workflow as it is configured:\n{{ JSON.stringify($('Pull the workflow out of GoHighLevel').item.json) }}\n\nThe test contact after the run:\n{{ JSON.stringify($json.contact) }}"
            }
          ]
        },
        "options": {
          "temperature": 0
        },
        "jsonOutput": true
      },
      "notes": "expected against what actually happened",
      "notesInFlow": true
    },
    {
      "name": "Anything off?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.message.content.passed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "notes": "clean runs just get logged",
      "notesInFlow": true
    },
    {
      "name": "Logged as a clean pass",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1440,
        200
      ],
      "parameters": {
        "operation": "append",
        "options": {},
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "Workflow checks (pick your sheet)"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "Passed"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Checked at": "={{ $now.toISO() }}",
            "Workflow": "={{ $('Point it at a workflow').item.json['Workflow name or ID'] }}",
            "Result": "passed"
          },
          "matchingColumns": [],
          "schema": []
        }
      },
      "notes": "so you can see it was checked",
      "notesInFlow": true
    },
    {
      "name": "Findings go into your check sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "operation": "append",
        "options": {},
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "Workflow checks (pick your sheet)"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "Findings"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Checked at": "={{ $now.toISO() }}",
            "Workflow": "={{ $('Point it at a workflow').item.json['Workflow name or ID'] }}",
            "Broken step": "={{ $json.message.content.broken_step }}",
            "Likely cause": "={{ $json.message.content.likely_cause }}",
            "Fix": "={{ $json.message.content.fix }}",
            "Confidence": "={{ $json.message.content.confidence }}"
          },
          "matchingColumns": [],
          "schema": []
        }
      },
      "notes": "one row per check",
      "notesInFlow": true
    },
    {
      "name": "The report lands in your inbox",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "sendTo": "={{ $('Point it at a workflow').item.json['Test email'] }}",
        "subject": "=Workflow check: {{ $('Point it at a workflow').item.json['Workflow name or ID'] }} needs a fix",
        "message": "=Broken step: {{ $json.message.content.broken_step }}\n\nLikely cause: {{ $json.message.content.likely_cause }}\n\nFix: {{ $json.message.content.fix }}\n\nHow sure: {{ $json.message.content.confidence }}\n\nChecked at {{ $now.toFormat('dd LLL yyyy HH:mm') }}",
        "options": {},
        "resource": "message",
        "operation": "send",
        "emailType": "text"
      },
      "notes": "the broken step and the fix",
      "notesInFlow": true
    }
  ],
