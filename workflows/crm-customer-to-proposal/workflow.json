            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI writes the email and the proposal": {
      "main": [
        [
          {
            "node": "Proposal saved as a Google Doc",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Proposal saved as a Google Doc": {
      "main": [
        [
          {
            "node": "Proposal text goes into the doc",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Proposal text goes into the doc": {
      "main": [
        [
          {
            "node": "Manager approves with one tap",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manager approves with one tap": {
      "main": [
        [
          {
            "node": "Approved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved?": {
      "main": [
        [
          {
            "node": "Email and proposal go out from your official mailbox",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Back to the team to rework",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email and proposal go out from your official mailbox": {
      "main": [
        [
          {
            "node": "Logged in your sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  }
}
